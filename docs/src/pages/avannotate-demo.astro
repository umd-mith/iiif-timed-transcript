---
import AVAnnotateDemo from "../components/AVAnnotateDemo.svelte";

// AVAnnotate "Voices" export, archived 2025-03-26 (upstream site reorganized away
// the standalone manifest). Vendored into docs/public so the demo stays stable.
// The player opens on canvas 0 (the Rukeyser reading); the file also contains two
// other recordings, but this demo shows a single canvas.
const manifestUrl = `${import.meta.env.BASE_URL}/manifests/avannotate-voices.json`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AVAnnotate Demo - IIIF Transcript Player</title>
    <meta
      name="description"
      content="Demonstration of the IIIF Transcript Player with supplementary annotations from an AVAnnotate manifest."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700;900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-parchment-100 bg-linen text-ink-900 antialiased">
    <!-- Navigation -->
    <nav
      class="fixed top-0 left-0 right-0 z-50 bg-parchment-50/95 backdrop-blur-sm border-b-2 border-ink-200"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a
              href="."
              class="text-xl font-serif font-bold text-ink-900 tracking-tight"
            >
              IIIF Transcript Player
            </a>
          </div>
          <div class="hidden md:flex items-center space-x-8">
            <a
              href="."
              class="text-ink-600 hover:text-terracotta-500 transition-colors font-medium"
              >Home</a
            >
            <a
              href="https://github.com/umd-mith/svelte-iiif-transcript-player"
              target="_blank"
              rel="noopener"
              class="text-ink-600 hover:text-terracotta-500 transition-colors font-medium"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 border-b-2 border-ink-200">
      <div class="max-w-4xl mx-auto">
        <div class="text-sm font-mono text-terracotta-400 mb-6 tracking-wider">
          DEMO
        </div>
        <h1
          class="text-5xl md:text-6xl font-serif font-bold text-ink-900 mb-6 leading-tight"
        >
          AVAnnotate: Supplementary Annotations
        </h1>
        <p
          class="text-xl text-ink-600 mb-4 max-w-3xl font-serif leading-relaxed"
        >
          This demo shows the player reading a real
          <a
            href="https://avannotate.github.io/voices/"
            target="_blank"
            rel="noopener"
            class="text-terracotta-500 hover:text-terracotta-600 underline"
            >AVAnnotate</a
          >
          export, where transcript annotations live in <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >canvas.annotations</code
          > rather than <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >canvas.items</code
          >. The manifest works as-is — there is no conversion step.
        </p>
        <p
          class="text-base text-ink-500 mb-8 max-w-3xl font-serif leading-relaxed"
        >
          The manifest uses <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >motivation: ["commenting", "tagging"]</code
          > with multi-body annotations — text content plus speaker and voice tags
          separated by W3C <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >purpose</code
          > field. The <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >buildTranscriptAnnotations()</code
          > function extracts these into the player's <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >Annotation[]</code
          > format automatically.
        </p>

        <!-- How it works -->
        <div class="bg-parchment-200 border-2 border-ink-200 p-6 mb-8">
          <h3 class="text-lg font-serif font-bold text-ink-900 mb-3">
            How it works
          </h3>
          <pre
            class="text-sm font-mono overflow-x-auto text-ink-800"><code class="language-typescript">{`import { ManifestSchema, getFirstCanvas, buildTranscriptAnnotations } from '@umd-mith/svelte-iiif-transcript-player';

// 1. Fetch and validate the IIIF manifest
const manifest = await fetch(manifestUrl).then(r => r.json());
const { data } = ManifestSchema.safeParse(manifest);

// 2. Extract transcript annotations from canvas.annotations
const canvas = getFirstCanvas(data);
const { annotations, skipped } = buildTranscriptAnnotations(canvas);
// → annotations[] with text, timing, and metadata.tags
// → skipped[] with reasons for any annotations that couldn't be placed on the timeline

// 3. Pass to the player — works identically to VTT-sourced annotations
<IIIFPlayer.Transcript {annotations}>
  <IIIFPlayer.TranscriptSearch />
  <IIIFPlayer.TranscriptSegments />
</IIIFPlayer.Transcript>`}</code></pre>
        </div>

        <div
          class="flex flex-wrap items-center gap-6 text-sm text-ink-500 border-t border-l-4 border-terracotta-300 pt-6 pl-6"
        >
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">canvas.annotations</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Multi-body annotations</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Speaker tags via W3C purpose</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Audio from Internet Archive</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Live Demo -->
    <section
      class="py-16 px-4 sm:px-6 lg:px-8 bg-parchment-50 border-b-2 border-ink-200"
    >
      <div class="max-w-7xl mx-auto">
        <div class="mb-8">
          <h2
            class="text-3xl md:text-4xl font-serif font-bold text-ink-900 mb-4"
          >
            Muriel Rukeyser — "The Speed of Darkness" (1969)
          </h2>
          <p class="text-lg text-ink-600 max-w-3xl font-serif leading-relaxed">
            A poetry reading at Sir George Williams University, annotated via
            <a
              href="https://avannotate.github.io/voices/"
              target="_blank"
              rel="noopener"
              class="text-terracotta-500 hover:text-terracotta-600 underline"
              >AVAnnotate Voices</a
            >. Timed annotations carry speaker identification and
            voice-characterization tags, read straight from the manifest's <code
              class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
              >canvas.annotations</code
            >.
          </p>
        </div>

        <div class="bg-white border-2 border-ink-200 shadow-2xl p-6 md:p-10">
          <AVAnnotateDemo client:load {manifestUrl} />
        </div>

        <div class="mt-6 text-sm text-ink-500">
          <p>
            Source: an
            <a
              href="https://avannotate.github.io/voices/"
              target="_blank"
              rel="noopener"
              class="text-terracotta-500 hover:text-terracotta-600 underline"
              >AVAnnotate &ldquo;Voices&rdquo;</a
            >
            export (archived 2025-03-26), vendored into this docs site so the demo
            stays stable.
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-4 sm:px-6 lg:px-8 bg-ink-900 text-ink-400">
      <div class="max-w-7xl mx-auto text-center">
        <p class="mb-4">
          Built by <a
            href="https://mith.umd.edu"
            target="_blank"
            rel="noopener"
            class="text-terracotta-400 hover:text-terracotta-300"
            >Maryland Institute for Technology in the Humanities</a
          >
        </p>
        <p class="text-sm">
          Licensed under BSD-3-Clause-Clear • <a
            href="https://github.com/umd-mith/svelte-iiif-transcript-player"
            target="_blank"
            rel="noopener"
            class="text-terracotta-400 hover:text-terracotta-300"
            >View on GitHub</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
