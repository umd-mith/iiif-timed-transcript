---
import ChaptersDemoPlayer from "../components/ChaptersDemo.svelte";

const manifestUrl =
  "https://iiif.io/api/cookbook/recipe/0026-toc-opera/manifest.json";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chapters Demo - IIIF Transcript Player</title>
    <meta
      name="description"
      content="Demonstration of IIIF Range/chapter navigation with the IIIF Transcript Player. Auto-parsed chapters from manifest.structures with seek-on-click and active tracking."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700;900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans bg-parchment-100 bg-linen text-ink-900 antialiased">
    <!-- Navigation -->
    <nav
      class="fixed top-0 left-0 right-0 z-50 bg-parchment-50/95 backdrop-blur-sm border-b-2 border-ink-200"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a
              href="."
              class="text-xl font-serif font-bold text-ink-900 tracking-tight"
            >
              IIIF Transcript Player
            </a>
          </div>
          <div class="hidden md:flex items-center space-x-8">
            <a
              href="."
              class="text-ink-600 hover:text-terracotta-500 transition-colors font-medium"
              >Home</a
            >
            <a
              href="https://github.com/umd-mith/svelte-iiif-transcript-player"
              target="_blank"
              rel="noopener"
              class="text-ink-600 hover:text-terracotta-500 transition-colors font-medium"
            >
              GitHub
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 border-b-2 border-ink-200">
      <div class="max-w-4xl mx-auto">
        <div class="text-sm font-mono text-terracotta-400 mb-6 tracking-wider">
          DEMO
        </div>
        <h1
          class="text-5xl md:text-6xl font-serif font-bold text-ink-900 mb-6 leading-tight"
        >
          IIIF Chapters: Range Navigation
        </h1>
        <p
          class="text-xl text-ink-600 mb-4 max-w-3xl font-serif leading-relaxed"
        >
          This demo shows automatic chapter navigation from
          <a
            href="https://iiif.io/api/presentation/3.0/#54-range"
            target="_blank"
            rel="noopener"
            class="text-terracotta-500 hover:text-terracotta-600 underline"
            >IIIF Range structures</a
          >. The <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >IIIFPlayer.Root</code
          > component parses <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >manifest.structures</code
          > automatically, and <code
            class="font-mono text-sm bg-parchment-200 px-1.5 py-0.5 rounded"
            >IIIFPlayer.Chapters</code
          > renders them as a navigable list. Chapters are read straight from the
          manifest — the display side of the same IIIF Range structures that AV authoring
          tools produce, with no extra format to adopt.
        </p>
        <p
          class="text-base text-ink-500 mb-8 max-w-3xl font-serif leading-relaxed"
        >
          Click any chapter to seek the video to that point. The active chapter
          highlights automatically as playback progresses. Built on <a
            href="https://iiif.io/api/cookbook/recipe/0026-toc-opera/"
            target="_blank"
            rel="noopener"
            class="text-terracotta-500 hover:text-terracotta-600 underline"
            >IIIF Cookbook recipe 0026</a
          > — a table of contents for a video recording of Lully's opera <em
            >Armide</em
          >.
        </p>

        <!-- How it works -->
        <div class="bg-parchment-200 border-2 border-ink-200 p-6 mb-8">
          <h3 class="text-lg font-serif font-bold text-ink-900 mb-3">
            How it works
          </h3>
          <pre
            class="text-sm font-mono overflow-x-auto text-ink-800"><code class="language-svelte">{`<script>
  import { IIIFPlayer } from '@umd-mith/svelte-iiif-transcript-player';
</script>

<!-- Chapters are auto-parsed from manifest.structures -->
<IIIFPlayer.Root {manifestUrl}>
  <IIIFPlayer.Viewer />
  <IIIFPlayer.Controls>
    <IIIFPlayer.PlayButton />
    <IIIFPlayer.Progress />
    <IIIFPlayer.Time />
  </IIIFPlayer.Controls>
  <IIIFPlayer.Chapters />
</IIIFPlayer.Root>`}</code></pre>
        </div>

        <div
          class="flex flex-wrap items-center gap-6 text-sm text-ink-500 border-t border-l-4 border-terracotta-300 pt-6 pl-6"
        >
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">IIIF Ranges</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Auto-parsed chapters</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Seek on click</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 bg-terracotta-400 rotate-45"></div>
            <span class="font-medium">Active tracking</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Live Demo -->
    <section
      class="py-16 px-4 sm:px-6 lg:px-8 bg-parchment-50 border-b-2 border-ink-200"
    >
      <div class="max-w-7xl mx-auto">
        <div class="mb-8">
          <h2
            class="text-3xl md:text-4xl font-serif font-bold text-ink-900 mb-4"
          >
            Lully — <em>Armide</em> (IIIF Cookbook)
          </h2>
          <p class="text-lg text-ink-600 max-w-3xl font-serif leading-relaxed">
            A video recording of Lully's opera <em>Armide</em>, from
            <a
              href="https://iiif.io/api/cookbook/recipe/0026-toc-opera/"
              target="_blank"
              rel="noopener"
              class="text-terracotta-500 hover:text-terracotta-600 underline"
              >IIIF Cookbook recipe 0026</a
            >. The manifest defines hierarchical Range structures for acts and
            scenes, which the player renders as a navigable chapter list.
          </p>
        </div>

        <div class="bg-white border-2 border-ink-200 shadow-2xl p-6 md:p-10">
          <ChaptersDemoPlayer client:load {manifestUrl} />
        </div>

        <div class="mt-6 text-sm text-ink-500">
          <p>
            Source manifest:
            <a
              href={manifestUrl}
              target="_blank"
              rel="noopener"
              class="text-terracotta-500 hover:text-terracotta-600 underline break-all"
            >
              {manifestUrl}
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-4 sm:px-6 lg:px-8 bg-ink-900 text-ink-400">
      <div class="max-w-7xl mx-auto text-center">
        <p class="mb-4">
          Built by <a
            href="https://mith.umd.edu"
            target="_blank"
            rel="noopener"
            class="text-terracotta-400 hover:text-terracotta-300"
            >Maryland Institute for Technology in the Humanities</a
          >
        </p>
        <p class="text-sm">
          Licensed under BSD-3-Clause-Clear • <a
            href="https://github.com/umd-mith/svelte-iiif-transcript-player"
            target="_blank"
            rel="noopener"
            class="text-terracotta-400 hover:text-terracotta-300"
            >View on GitHub</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
