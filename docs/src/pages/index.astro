					<!-- Basic Usage -->
					<div class="border-l-4 border-terracotta-400 pl-8">
						<h3 class="text-2xl font-serif font-bold text-ink-900 mb-4">Basic Usage</h3>
						<div class="bg-parchment-200 border-2 border-ink-200 p-6">
							<pre class="text-sm font-mono overflow-x-auto text-ink-800"><code class="language-svelte">{`<script>
  import { IIIFPlayer, type Annotation } from '@umd-mith/svelte-iiif-transcript-player';

  const manifestUrl = 'https://example.org/manifest.json';

  // Parsed VTT or IIIF annotations
