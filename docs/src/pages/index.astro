---
import IIIFTranscriptDemo from '../components/IIIFTranscriptDemo.svelte';
import { parseText } from 'media-captions';
import {
	ManifestSchema,
	getFirstCanvas,
	buildTranscriptAnnotations,
	getSupplementaryVTTTracks,
} from '@umd-mith/svelte-iiif-transcript-player';

const manifestUrl = 'https://iiif.io/api/cookbook/recipe/0219-using-caption-file/manifest.json';
const vttUrl = 'https://fixtures.iiif.io/video/indiana/lunchroom_manners/lunchroom_manners.vtt';

// Extract transcript from IIIF manifest at build time for SEO structured data.
// Strategy: try embedded annotations first, fall back to referenced VTT.
const manifestResponse = await fetch(manifestUrl);
const manifestJson = await manifestResponse.json();
const { data: manifest } = ManifestSchema.safeParse(manifestJson);
const canvas = manifest ? getFirstCanvas(manifest) : undefined;

let transcript = '';
if (canvas) {
	// Path A: Annotations embedded directly in the manifest
	const annotations = buildTranscriptAnnotations(canvas);
	if (annotations.length > 0) {
		transcript = annotations.map((a) => a.text).join(' ');
	} else {
		// Path B: Manifest references an external VTT file (recipe 0219)
		const vttTracks = getSupplementaryVTTTracks(canvas);
		if (vttTracks.length > 0) {
			const vttText = await fetch(vttTracks[0].src).then((r) => r.text());
			const { cues } = await parseText(vttText, { type: 'vtt' });
			transcript = cues.map((cue) => cue.text).join(' ');
		}
	}
}

// Structured data: VideoObject with transcript for search engines and AI
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "VideoObject",
	"name": manifest?.label?.en?.[0] ?? "Lunchroom Manners",
	"description": "An educational film about lunchroom manners, with synchronized transcript. Demonstrates the IIIF Transcript Player component library.",
	"thumbnailUrl": "https://fixtures.iiif.io/video/indiana/lunchroom_manners/lunchroom_manners.jpg",
	"uploadDate": "2024-01-01",
	"contentUrl": "https://fixtures.iiif.io/video/indiana/lunchroom_manners/high/lunchroom_manners-high.mp4",
	"transcript": transcript,
};
---

